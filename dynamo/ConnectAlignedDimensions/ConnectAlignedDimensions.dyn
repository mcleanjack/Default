    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "NodeType": "BooleanInputNode",
      "InputValue": true,
      "Id": "6cd681f717404bc9a4f58bbfef3e375d",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "eb80016f35104d86a514b690c137d9f6",
          "Name": "",
          "Description": "Boolean",
          "UsingDefaultValue": false,
